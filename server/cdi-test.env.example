# CDI GEST - EMPRESA DE ENSAYO (OPCION PREDETERMINADA SEGURA)
# La empresa de pruebas debe ser distinta de la de producción. Ver al final el modo piloto excepcional.
# No publicar el secreto ni copiarlo a variables VITE_*.
CDI_TEST_EMPRESA=
CDI_TEST_API_KEY=
CDI_TEST_WRITES_ENABLED=false
CDI_TEST_ENVIRONMENT_CONFIRMED=

# Solo después de recibir una empresa de pruebas de CDI, con pedidos de ensayo:
# CDI_TEST_EMPRESA=BDxxxxxx (DISTINTA de CDI_EMPRESA)
# CDI_TEST_WRITES_ENABLED=true
# CDI_TEST_ENVIRONMENT_CONFIRMED=SI_ENTORNO_DE_PRUEBAS

# ALTERNATIVA EXCEPCIONAL: prueba REAL en la empresa productiva de un ÚNICO PC.
# No actives estas variables hasta decidir conscientemente usar datos reales.
# No permite limpiar automáticamente el albarán ni revertir existencias.
# CDI_READ_ENABLED=true
# CDI_EMPRESA=BD000001
# CDI_API_KEY=... (tu clave privada ya configurada)
# CDI_PILOT_WRITES_ENABLED=false
# CDI_PILOT_EMPRESA=BD000001
# CDI_PILOT_ORDER=PC|2026|A|NUMERO_REAL_DEL_PEDIDO
# CDI_PILOT_PRODUCTION_CONFIRMED=ACEPTO_ALBARAN_REAL_EN_PRODUCCION
# Tras el ensayo, poner CDI_PILOT_WRITES_ENABLED=false y desplegar.
